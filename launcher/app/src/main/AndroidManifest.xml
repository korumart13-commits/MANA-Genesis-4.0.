<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="com.mana.permission.BIND_BRAIN" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:label="MANA Design Launcher"
        android:theme="@style/ManaOneUiTheme"
        android:usesCleartextTraffic="false">
        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
        <service
            android:name=".ManaVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/mana_voice_interaction" />
        </service>
        <service
            android:name=".ManaVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>
        <service
            android:name=".ManaEngineBridgeService"
            android:exported="true"
            android:permission="com.mana.permission.BIND_BRAIN">
            <intent-filter>
                <action android:name="com.mana.action.BIND_ENGINE_BACKEND" />
            </intent-filter>
        </service>
        <service
            android:name=".ManaEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Owner-enabled persistent MANA AI engine runtime" />
        </service>
        <service
            android:name=".ManaFloatingAvatarService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled persistent floating MANA avatar overlay" />
        </service>
        <activity
            android:name=".ManaAvatarPreviewActivity"
            android:exported="false" />
        <activity android:name=".ManaSystemStatusActivity" android:exported="false" />
        <activity android:name=".ManaDiagnosticsActivity" android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mana_file_paths" />
        </provider>
        <activity android:name=".ManaIntegrationSettingsActivity" android:exported="false" />
        <activity android:name=".ManaEngineeringActivity" android:exported="false" />
        <activity android:name=".ManaDocumentStorageActivity" android:exported="false" />
        <activity android:name=".ManaDevicesActivity" android:exported="false" />
        <activity
            android:name=".ManaFutureUpdatesActivity"
            android:exported="false" />
        <activity
            android:name=".ManaAdaptiveLearningActivity"
            android:exported="false" />
        <activity
            android:name=".ManaWallpaperStudioActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
