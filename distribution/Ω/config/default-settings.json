{
  "schemaVersion": 2,
  "theme": {
    "name": "mana_dark_navy",
    "background": "#071426",
    "surface": "#102B50",
    "primary": "#1765A8",
    "accent": "#54C8F5",
    "text": "#EAF4FF",
    "secondary": "#91A9C5",
    "style": "Android-first Material 3, not an iOS imitation"
  },
  "language": "ru-RU",
  "offlineFirst": true,
  "localInference": {
    "required": true,
    "preferredEngine": "LiteRT-LM",
    "preferredModel": "Gemma 4 E2B IT",
    "backendOrder": [
      "GPU",
      "CPU"
    ],
    "cloudFallback": false,
    "doNotPretendReadyWithoutModel": true,
    "minimumAvailablePhysicalRamMb": 3548,
    "memoryGateType": "conservative_estimate_not_vendor_minimum"
  },
  "internetResearch": {
    "enabled": true,
    "background": true,
    "wifiPreferred": true,
    "verifySources": true,
    "treatWebContentAsUntrusted": true
  },
  "selfDevelopment": {
    "enabled": true,
    "autoResearch": true,
    "autoInstallChanges": false,
    "requireTests": true,
    "requireIsolatedValidation": true,
    "requireOwnerApprovalForSystemChanges": true,
    "rollbackRequired": true
  },
  "lockScreen": {
    "manaWallpaper": true,
    "autoGenerate": true,
    "intervalMinutes": 15,
    "allowedIntervalsMinutes": [
      15,
      30,
      60,
      180
    ],
    "target": "lock",
    "neverChangeHomeScreen": true,
    "renderMode": "generated_static_image",
    "note": "WorkManager timing is controlled by Android and may be delayed; true animated lock-screen wallpaper is not yet verified."
  },
  "voice": {
    "language": "ru-RU",
    "offlineRequired": true,
    "preferredEngine": "Piper",
    "voice": "ru_RU-irina-medium",
    "bundledInApkAfterSuccessfulBuild": true
  },
  "avatar": {
    "enabled": true,
    "identity": "one_persistent_MANA_character",
    "preserveExistingBehavior": true,
    "allowOutfitAndAccessoryChanges": true
  },
  "navigation": {
    "style": "compact_android_navigation",
    "sections": [
      "Главная",
      "Чат",
      "Модули",
      "Приложения"
    ]
  },
  "accessibility": {
    "minimumTouchTargetDp": 48,
    "supportLargeText": true,
    "supportTalkBack": true,
    "avoidGestureOnlyActions": true
  },
  "resourceGovernor": {
    "enabled": true,
    "respectBattery": true,
    "respectThermalLimits": true,
    "allowSafeModelUnload": true
  },
  "cloudAI": {
    "enabled": false,
    "providers": [
      "openai",
      "anthropic",
      "google",
      "xai"
    ],
    "userSuppliedKeysOnly": true
  },
  "integrations": {
    "yandex": "optional_owner_configured",
    "vk": "optional_owner_configured",
    "minecraft": "optional",
    "wearables": "optional",
    "earbuds": "optional",
    "carBluetooth": "optional",
    "googleServices": "optional_owner_authorized_oauth",
    "requiresGoogleMobileServices": false
  },
  "confirmations": {
    "payments": true,
    "messages": true,
    "calls": true,
    "posts": true,
    "installs": true,
    "deletions": true,
    "systemChanges": true,
    "firmwareAndRecovery": true
  },
  "firmware": {
    "target": "AOSP Android 16 for exact RMX5566RU / RE645F",
    "preserveAsProjectGoal": true,
    "flashableImageAvailable": false,
    "releaseBlockedUntilDeviceInputsAndRecoveryAreVerified": true,
    "bootBranding": "MANA_future_ROM_requirement"
  },
  "autonomy": {
    "level": "maximum",
    "policy": "within_Android_permissions_and_owner_consent",
    "requireOwnerConfirmationForConsequentialActions": true
  },
  "backgroundExecution": {
    "target": "continuous_research_and_learning",
    "mode": "WorkManager_plus_user_visible_foreground_service",
    "guaranteed24x7": false,
    "note": "Android may delay or stop background work; no hidden persistence or battery-policy bypass."
  },
  "systemIdentity": {
    "productName": "MANA",
    "assistantName": "MANA",
    "userFacingAboutName": "MANA",
    "hideLLMLabelInUserFacingSettings": true,
    "bootBrandingTarget": "MANA_future_ROM"
  }
}
