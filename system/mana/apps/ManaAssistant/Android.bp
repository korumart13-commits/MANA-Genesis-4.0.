android_app {
    name: "ManaAssistant",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    static_libs: ["mana-brain-interface"],
    sdk_version: "current",
    min_sdk_version: "29",
    target_sdk_version: "36",
    certificate: "default",
    privileged: false,
    product_specific: true,
}
