android_test {
    name: "ManaBrainInstrumentationTests",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    static_libs: ["mana.brain-java"],
    libs: ["android.test.runner"],
    sdk_version: "test_current",
    instrumentation_for: "ManaAssistant",
    test_suites: ["device-tests"],
    certificate: "default",
}
