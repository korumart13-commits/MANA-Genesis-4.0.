android_app {
    name: "ManaSettings",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    min_sdk_version: "29",
    target_sdk_version: "36",
    certificate: "default",
    privileged: false,
    product_specific: true,
}
